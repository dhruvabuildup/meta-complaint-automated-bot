# ==============================================================================
# Meta Comment & DM Automation Bot - Environment Configuration (.env.example)
# Note: Copy this file to .env and replace placeholders with real values.
# NEVER commit .env to version control!
# ==============================================================================

# Application environment: local, staging, or production
APP_ENV=local

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Meta App Credentials
# APP_ID: Facebook App ID from App Dashboard -> Settings -> Basic
APP_ID=your_meta_app_id_here
# APP_SECRET: Facebook App Secret used for HMAC-SHA256 signature verification and app tokens
APP_SECRET=your_meta_app_secret_here
# VERIFY_TOKEN: Custom secret token configured in Meta Webhooks dashboard for GET verification
VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta Graph API Configuration
# GRAPH_VERSION: Pinned Graph API version (must match dashboard API version)
# TODO(verify): Confirm the active supported Graph API version in Meta developer docs
GRAPH_VERSION=v25.0
# GRAPH_BASE_URL: Base URL for Meta Graph API calls
GRAPH_BASE_URL=https://graph.facebook.com

# Meta Assets Identification
# PAGE_ID: The numeric ID of the single Facebook Page being automated
PAGE_ID=your_facebook_page_id_here
# IG_ACCOUNT_ID: The linked Instagram Professional Account ID (instagram_business_account)
IG_ACCOUNT_ID=your_instagram_account_id_here
# PAGE_ACCESS_TOKEN: System User or Page access token with required scopes. Optional at boot for local dev.
PAGE_ACCESS_TOKEN=your_page_access_token_here

# Storage & Infrastructure
# DATABASE_URL: PostgreSQL connection string using asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/meta_bot
# REDIS_URL: Redis connection URL for queues, deduplication, and rate limit counters
REDIS_URL=redis://localhost:6379/0

# Security & Encryption
# TOKEN_ENC_KEY: 32 url-safe base64-encoded bytes for Fernet symmetric encryption of stored tokens at rest
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
# ADMIN_TOKEN: Internal bearer token required to access administrative/ops endpoints
ADMIN_TOKEN=your_internal_admin_bearer_token_here

# Rate Limits & Pacing (Meta ceiling: 750 private replies/hr/IG account; we run conservative defaults)
# MAX_PRIVATE_PER_HOUR: Maximum private replies permitted per hour (range: 1..750)
MAX_PRIVATE_PER_HOUR=100
# MAX_PRIVATE_PER_DAY: Maximum private replies permitted per rolling 24h window
MAX_PRIVATE_PER_DAY=1000
# SEND_DELAY_MIN_SECONDS: Minimum jitter delay before sending the first DM (pace automation)
SEND_DELAY_MIN_SECONDS=20
# SEND_DELAY_MAX_SECONDS: Maximum jitter delay before sending the first DM
SEND_DELAY_MAX_SECONDS=60
# PUBLIC_REPLY_RATIO: Fraction of comments to reply publicly (0.0 to 1.0)
PUBLIC_REPLY_RATIO=0.3

# Meta Policy Windows
# DM_WINDOW_HOURS: Standard customer service messaging window after user DM (24 hours)
DM_WINDOW_HOURS=24
# PRIVATE_REPLY_WINDOW_DAYS: Allowed window to send private reply from a comment (7 days)
PRIVATE_REPLY_WINDOW_DAYS=7

# Bot Timing & Fallback Budgets
# BOT_REPLY_BUDGET_SECONDS: Max total seconds before fallback must be triggered (Meta expects <30s response)
BOT_REPLY_BUDGET_SECONDS=20
# LLM_TIMEOUT_SECONDS: Timeout for external LLM inference before falling back
LLM_TIMEOUT_SECONDS=12

# Operational Controls
# ALERT_WEBHOOK_URL: Optional external Slack/Discord webhook URL for critical operational alerts
ALERT_WEBHOOK_URL=
# KILL_SWITCH_DEFAULT: Initial state of the global kill switch at startup (true=block all automated sends)
KILL_SWITCH_DEFAULT=false
# DEMO_MODE: When true, Graph API write calls are logged instead of executing on Meta
DEMO_MODE=false
# MAX_IDENTICAL_PUBLIC_PER_POST: Maximum identical public replies on the same post
MAX_IDENTICAL_PUBLIC_PER_POST=3
# CIRCUIT_BREAKER_ERROR_THRESHOLD: Consecutive critical Meta errors before tripping circuit breaker
CIRCUIT_BREAKER_ERROR_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS: Cooldown before circuit breaker reset
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=3600
# DEFAULT_HUMAN_CONTACT: Support email or escalation channel included in first DM disclosure
DEFAULT_HUMAN_CONTACT=support@example.com
